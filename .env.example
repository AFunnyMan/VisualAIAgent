# Copy to .env locally; never commit .env. All three fields are required for the Agent.
VAA_API_KEY=
VAA_API_BASE_URL=
VAA_AGENT_MODEL=
# responses or chat_completions; provider must support function tools.
# Tested Qwen configuration: see docs/qwen.md (never paste a real key into this example).
VAA_API_MODE=responses
VAA_API_TIMEOUT_SECONDS=30
VAA_DAILY_AUTO_LIMIT=20
VAA_TIMEZONE=Asia/Shanghai
VAA_DATA_DIR=data
VAA_MODEL_PATH=models/yolo26n-e2e.onnx
# Optional override; official prepared model uses its adjacent manifest.
VAA_MODEL_SHA256=
VAA_CAMERA_INDEX=0
VAA_CAMERA_WIDTH=640
VAA_CAMERA_HEIGHT=480
# Optional normalized crop: left,top,right,bottom. Empty means the full frame.
VAA_OBSERVATION_REGION=
VAA_SAMPLE_INTERVAL=1
VAA_CONFIDENCE=0.35

# Optional same-frame local cup recheck at scale 0.75; extra inference, not universal accuracy.
VAA_CUP_SCALE_RECHECK=false

# Experimental fixed-scene behavior; disabled unless explicitly enabled.
# These are local training manifests, not ONNX paths. Weights/images stay untracked.
VAA_BEHAVIOR_ENABLED=false
VAA_BEHAVIOR_POSTURE_MANIFEST=
VAA_BEHAVIOR_DRINKING_MANIFEST=
VAA_BEHAVIOR_MODEL_VERSION=behavior-r03
VAA_BEHAVIOR_SCENE_ID=default
VAA_BEHAVIOR_SEAT_ROI=0.2,0.2,0.95,1.0
# The person auxiliary reuses the manifest-verified object model in this stage.
